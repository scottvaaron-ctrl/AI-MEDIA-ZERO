# ============================================================
# AI Media Zero - environment configuration
# Copy to .env and edit. NEVER commit .env.
# ============================================================

# ---- Budget (owner-only) -----------------------------------
# Hard monthly cap on usage-based software spend. The AI cannot change this.
# V0 default is $0.00. Every provider call is authorized against this cap.
MONTHLY_BUDGET_USD=0.00
# Paid providers are never even registered unless this is true AND the budget is > 0.
ALLOW_PAID_PROVIDERS=false

# ---- Local LLM (Ollama) -------------------------------------
OLLAMA_HOST=http://127.0.0.1:11434
# qwen3:8b (~5 GB) writes noticeably better scripts on an 8 GB GPU; qwen3:4b works but produces thinner drafts.
OLLAMA_MODEL=qwen3:8b
# Optional smaller/faster model for cheap classification tasks (comments). Blank = same model.
OLLAMA_FAST_MODEL=
OLLAMA_TIMEOUT_S=600
OLLAMA_NUM_CTX=8192
# ollama | fixture   ("fixture" runs the whole pipeline offline with canned deterministic LLM output)
LLM_PROVIDER=ollama

# ---- Local TTS (Piper) --------------------------------------
# piper | silent    ("silent" renders timed silence; only for offline tests)
TTS_PROVIDER=piper
PIPER_VOICE=en_US-lessac-medium
# Voice .onnx/.onnx.json files are downloaded once from Hugging Face (free) into this folder.
PIPER_VOICES_DIR=./data/voices
PIPER_AUTO_DOWNLOAD=true
PIPER_LENGTH_SCALE=1.0

# ---- Rendering ----------------------------------------------
# Leave blank to auto-detect: ffmpeg on PATH, then the bundled imageio-ffmpeg binary.
FFMPEG_BIN=
FFPROBE_BIN=
FONT_FILE=C:/Windows/Fonts/arialbd.ttf

# ---- Publishing ---------------------------------------------
# draft     = prepare a package only, no API writes (default, safest)
# private   = upload to YouTube as private (requires OAuth, kill switch off, owner approval)
# scheduled = upload private with a publishAt time (requires OAuth)
# public    = owner explicitly opts in; note unaudited API projects are locked to private by YouTube
YOUTUBE_MODE=draft
YOUTUBE_DEFAULT_PRIVACY=private
YOUTUBE_ENABLED=false
YOUTUBE_CLIENT_SECRET_FILE=./secrets/client_secret.json
YOUTUBE_TOKEN_FILE=./secrets/youtube_token.json
YOUTUBE_ANALYTICS_ENABLED=false

# Owner consent for fully autonomous uploads to YOUR OWN accounts without per-video approval.
# Required by YouTube's Developer Policies (prior, express consent). The kill switch still overrides it.
AUTOPUBLISH_CONSENT=false

# TikTok: package = owner posts by hand (default); direct = official Content Posting API (needs a registered app).
TIKTOK_MODE=package
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_TOKEN_FILE=./secrets/tiktok_token.json
# SELF_ONLY until your TikTok app passes its audit; then PUBLIC_TO_EVERYONE. Blank = choose per post in the dashboard.
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
TIKTOK_ANALYTICS_ENABLED=false

# ---- Paths --------------------------------------------------
AIMZ_DATA_DIR=./data
AIMZ_DB_PATH=./data/aimz.sqlite3
AIMZ_CONFIG_DIR=./config
AIMZ_LOG_LEVEL=INFO

# ---- Dashboard ----------------------------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8420

# ---- Research -----------------------------------------------
# Wikimedia asks for a descriptive User-Agent with contact info.
AIMZ_USER_AGENT=AIMediaZero/0.1 (https://github.com/your-user/ai-media-zero; you@example.com)
